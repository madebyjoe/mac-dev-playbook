# Each profile is a DISTINCT host alias (all resolving to the local machine by
# default). This is deliberate: Ansible resolves group_vars per host, so giving
# every profile its own host stops work.yml's empty profile_* lists from
# overriding personal/headless when the plays run.
#
# BECAUSE all three aliases are the same physical machine, `--limit` is
# MANDATORY. Running `ansible-playbook main.yml` with no limit targets all three
# aliases at once and merges every profile's variables. See README.
#
#   ansible-playbook main.yml --limit personal
#   ansible-playbook main.yml --limit work
#   ansible-playbook main.yml --limit headless

[personal]
mac-personal ansible_connection=local

[work]
mac-work ansible_connection=local

[headless]
mac-headless ansible_connection=local
# To provision a *remote* headless Mac instead of this machine, comment out the
# line above and use an SSH alias like:
# mac-headless ansible_host={remote-ip} ansible_user={client-username} ansible_connection=ssh

# Inference-role groups (F4) are ORTHOGONAL to profiles. A host may be in one
# profile group and AT MOST ONE inference-role group. Inference configuration
# (bind, keep-alive, model manifest selection) keys off membership here, never
# off "ollama happens to be installed". Both are empty by default.
#
# A host that joins a role must set its tailnet identity so the bind and the
# LiteLLM snippet resolve:
#   tailnet_ip   -> OLLAMA_HOST bind (e.g. 100.x.y.z)
#   tailnet_name -> LiteLLM api_base host (e.g. mac-headless.tailXXXX.ts.net)
#
# Example: make the headless box a small inference node.
#   [inference_small]
#   mac-headless tailnet_ip=100.64.0.10 tailnet_name=mac-headless.tailnet.ts.net
[inference_small]

# Example: make a beefier box (M4 Pro) a medium inference node.
#   [inference_medium]
#   mac-headless tailnet_ip=100.64.0.11 tailnet_name=mac-studio.tailnet.ts.net
[inference_medium]

# All profiles get core packages.
[profiles:children]
personal
work
headless

[profiles:vars]
ansible_python_interpreter=/usr/bin/python3
