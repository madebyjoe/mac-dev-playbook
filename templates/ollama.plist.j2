<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ollama.serve</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/ollama</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>OLLAMA_HOST</key>
        {#- Loopback by default. A non-loopback bind exposes an UNAUTHENTICATED
            inference API on that interface (ollama has no auth of its own). Only
            inference-role group_vars set a non-loopback `ollama_bind`, and the
            preferred value is the host's Tailscale interface IP so LiteLLM on
            Unraid reaches the backend over the tailnet -- never 0.0.0.0. The
            work VLAN is a backstop, not the access control. -#}
        <string>{{ ollama_bind | default('127.0.0.1:11434') }}</string>
{% if ollama_keep_alive is defined %}
        {#- Inference-role hosts pin the model resident (-1) for G19 latency. -#}
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>{{ ollama_keep_alive }}</string>
{% endif %}
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ ollama_log_dir | default(ansible_env.HOME + '/Library/Logs/ollama') }}/ollama.log</string>
    <key>StandardErrorPath</key>
    <string>{{ ollama_log_dir | default(ansible_env.HOME + '/Library/Logs/ollama') }}/ollama.err</string>
</dict>
</plist>