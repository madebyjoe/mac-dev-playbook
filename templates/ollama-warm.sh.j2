#!/bin/sh
# GENERATED by mac-dev-playbook (tasks/configure-ollama.yml). Do not edit here.
#
# Warm-keeper for the PIPELINE ollama instance (Fault B, mitigation 3).
#
# What it does: issues a zero-work load request for each pinned pipeline model
# every {{ ollama_warm_interval | default(240) }}s, so neither can ever be the
# least-recently-used model when ollama picks an eviction victim.
#
# What it is NOT: a fix. OLLAMA_KEEP_ALIVE=-1 only defeats the idle timer; at the
# slot cap ollama evicts the LRU model regardless of keep-alive. The actual fix
# is the dev/pipeline instance split plus an honestly-sized
# OLLAMA_MAX_LOADED_MODELS — this just removes the last way a burst of pipeline
# idleness can lose a slot. It cannot help an over-subscribed slot budget.
set -u

BIND="{{ ollama_bind | default('127.0.0.1:11434') }}"
KEEP_ALIVE="{{ ollama_keep_alive | default(-1) }}"
TIMEOUT={{ ollama_warm_timeout | default(120) }}

warm() {   # warm <api-path> <json-body>
  curl -sS -m "$TIMEOUT" -o /dev/null -w "%{http_code}" \
    -X POST "http://${BIND}/$1" -H 'Content-Type: application/json' -d "$2"
}

echo "=== $(date '+%Y-%m-%dT%H:%M:%S%z') warming pipeline models on ${BIND} ==="
{% for m in (ollama_pinned_models | default([])) %}
{#- Embedding models have no /api/generate; load them through /api/embed. #}
{%- if 'embed' in (m.serves_alias | default('')) %}
code=$(warm api/embed '{"model":"{{ m.name }}","input":"","keep_alive":'"${KEEP_ALIVE}"'}')
{%- else %}
code=$(warm api/generate '{"model":"{{ m.name }}","prompt":"","keep_alive":'"${KEEP_ALIVE}"'}')
{%- endif %}
echo "  {{ m.name }} ({{ m.serves_alias | default('-') }}) -> http ${code}"
{%- endfor %}
