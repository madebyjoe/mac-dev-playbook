# LiteLLM model_list snippet — GENERATED by mac-dev-playbook. Do not edit here.
# Host: {{ inventory_hostname }}   inference role: {{ inference_role }}
#
# Apply this on the LiteLLM router (Unraid). The playbook only EMITS this file
# (F8); it never reaches across to the router. Regenerated whenever this
# inference node is provisioned. api_base uses the host's LAN IP (G30 = LAN,
# G33 raw lan_ip). Bare aliases (model_name: "<alias>") are AUTHORITATIVE — they
# come from manifest serves_alias markers; only NEW aliases still need confirming
# against Brief 1's register. Role-namespaced entries (model_name: "<role>/<model>")
# are also emitted.
model_list:
{% for m in litellm_models %}
{% set _prefix = 'openai' if m.engine == 'llamacpp' else 'ollama' %}
{% set _port = m.port if m.engine == 'llamacpp' else 11434 %}
  - model_name: "{{ inference_role }}/{{ m.name }}"
    litellm_params:
      model: "{{ _prefix }}/{{ m.name }}"
      api_base: "http://{{ lan_ip | default(inventory_hostname) }}:{{ _port }}/v1"
{% if m.engine == 'llamacpp' %}
      api_key: "dummy"
{% endif %}
{% if m.serves_alias is defined and m.serves_alias %}
  - model_name: "{{ m.serves_alias }}"
    litellm_params:
      model: "{{ _prefix }}/{{ m.name }}"
      api_base: "http://{{ lan_ip | default(inventory_hostname) }}:{{ _port }}/v1"
{% if m.engine == 'llamacpp' %}
      api_key: "dummy"
{% endif %}
{% endif %}
{% endfor %}
