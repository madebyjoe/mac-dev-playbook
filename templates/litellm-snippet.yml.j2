# LiteLLM model_list snippet — GENERATED by mac-dev-playbook. Do not edit here.
# Host: {{ inventory_hostname }}   inference role: {{ inference_role }}   transport: {{ inference_transport }}
#
# Apply this on the LiteLLM router (Unraid). The playbook only EMITS this file
# (F8); it never reaches across to the router. Regenerated whenever this
# inference node is provisioned. Bare aliases (model_name: "<alias>") are
# AUTHORITATIVE — they come from manifest serves_alias markers; only NEW aliases
# still need confirming against Brief 1's register. Role-namespaced entries
# (model_name: "<role>/<model>") are also emitted.
{% set _front = (inference_transport | default('lan')) == 'tailnet' %}
{% if _front %}
{% set _api_host = tailnet_api_host | default(tailnet_ip | default('')) %}
{% set _api_port = inference_front_tailnet_port | default(11434) %}
#
# TRANSPORT: tailnet (G30 r4 — this host ROAMS).
# api_base is the host's TAILNET address ({{ _api_host }}), not its LAN IP: the
# LAN IP is wrong half the time at home and meaningless on public Wi-Fi. Raw IP
# rather than the MagicDNS name per G-MDP4-1 (no DNS dependency in the inference
# path); override `tailnet_api_host` to use the name instead.
#
# What the router is actually talking to, hop by hop:
#   {{ '%-22s' | format(_api_host ~ ':' ~ _api_port) }} -> `tailscale serve --tcp` on the laptop (TCP forward)
#   {{ '%-22s' | format('127.0.0.1:' ~ (ollama_front_port | default(11436))) }} -> Caddy, which rewrites Host -> localhost:11434
#   {{ '%-22s' | format('127.0.0.1:11434') }} -> ollama, bound to loopback ONLY (F-MDP4-2)
# The Caddy hop exists because loopback ollama 403s any request whose Host
# header is not localhost-ish, and `tailscale serve` forwards the caller's Host
# untouched and cannot rewrite it. See runbooks/inference-front.md.
#
# THE AUTH FOR THIS PORT IS THE TAILNET ACL, nothing else. Only `tag:llm-router`
# may reach `tag:inference-roaming:{{ _api_port }}` (human track H2). ollama has no auth
# of its own; the ACL file is the policy record for this one path.
#
# ROUTER-SIDE (human, H3): a laptop in a tunnel must FAIL FAST, not hang. Set a
# 2–3s connect timeout, a low `allowed_fails` and a cooldown on these entries,
# and declare `fallbacks: {medium: [medium-degraded]}`.
{% else %}
{% set _api_host = lan_ip | default(inventory_hostname) %}
{% set _api_port = none %}
#
# TRANSPORT: lan (G30 r4 — this host is STATIONARY). api_base uses the host's
# raw LAN IP (G33), backed by a static DHCP reservation.
{% endif %}
{% if ollama_dev_enabled | default(false) | bool %}
#
# TWO OLLAMA INSTANCES ON THIS HOST (M1 Pro remediation, Fault B):
#   :11434  PIPELINE — the alias-serving models ONLY (tier: pipeline/standby).
#                      Slot budget {{ ollama_max_loaded_models | default('unset') }}, keep-alive {{ ollama_keep_alive | default('unset') }}.
#   :{{ ollama_dev_port | default(11435) }}  DEV      — the ad-hoc zoo (tier: dev), own slot budget,
#                      finite keep-alive, emitted below under the `dev/` namespace.
# Every dev/* entry MUST point at :{{ ollama_dev_port | default(11435) }}. Pointing one back at :11434
# re-creates the model-slot thrashing that made `small` 16–76s and `embed`
# intermittently return `Compute error.` 500s — the pipeline models get evicted
# because ollama drops the least-recently-used model at the slot cap, keep-alive
# -1 or not. This is the whole reason the second instance exists.
{% endif %}
model_list:
{% for m in litellm_models %}
{# ollama shares one instance per RESIDENCY class; llamacpp/whisper are OpenAI-compatible on their own port. #}
{% set _prefix = 'ollama' if m.engine == 'ollama' else 'openai' %}
{% set _tier = m.tier | default('dev') %}
{% set _is_dev = (m.engine == 'ollama') and (_tier == 'dev') and (ollama_dev_enabled | default(false) | bool) %}
{% set _backend_port = (ollama_dev_port | default(11435)) if _is_dev else (11434 if m.engine == 'ollama' else m.port) %}
{% set _ns = 'dev' if _is_dev else inference_role %}
{# Under `tailnet` the ONLY port with a remote route is the fronted pipeline
   :11434. Anything else on this host is loopback-bound with no front of its own
   (N3), so it is emitted COMMENTED OUT rather than as a live entry the router
   would dial and hang on. Under `lan` every port is directly reachable. #}
{% set _routed = (not _front) or (_backend_port == 11434) %}
{% set _c = '' if _routed else '# ' %}
{% set _port = _api_port if (_front and _routed) else _backend_port %}
{% if not _routed %}
  # NO TAILNET ROUTE (N3): {{ m.name }} serves 127.0.0.1:{{ _backend_port }} on this roaming
  # host, and `tailscale serve` fronts :11434 only. Give it its own front route
  # (a second Caddy site + serve rule) before uncommenting, or the router will
  # dial a port that nothing answers on.
{% endif %}
{{ _c }}  - model_name: "{{ _ns }}/{{ m.name }}"
{{ _c }}    litellm_params:
{{ _c }}      model: "{{ _prefix }}/{{ m.name }}"
{{ _c }}      api_base: "http://{{ _api_host }}:{{ _port }}/v1"
{% if m.engine != 'ollama' %}
{{ _c }}      api_key: "dummy"
{% endif %}
{# Bare aliases: serves_alias (v1.1) plus any also_serves (v1.3). They render
   identically -- same backend, same tag -- because an also_serves entry IS an
   alias, not a second model. `plan_model_pulls.py --lint` enforces that no two
   entries in a role claim the same name across both fields. #}
{% set _aliases = ([m.serves_alias] if (m.serves_alias is defined and m.serves_alias) else []) + (m.also_serves | default([]) | list) %}
{% for _alias in _aliases %}
{% if _alias != m.serves_alias %}
{{ _c }}  # `{{ _alias }}` is an ALIAS for the same backend and tag as `{{ m.serves_alias | default(m.name) }}`
{{ _c }}  # (manifest also_serves). Declaring it lets the router name this backend as a
{{ _c }}  # fallback without pretending it is a different model.
{% endif %}
{{ _c }}  - model_name: "{{ _alias }}"
{{ _c }}    litellm_params:
{{ _c }}      model: "{{ _prefix }}/{{ m.name }}"
{{ _c }}      api_base: "http://{{ _api_host }}:{{ _port }}/v1"
{% if m.engine != 'ollama' %}
{{ _c }}      api_key: "dummy"
{% endif %}
{% endfor %}
{% endfor %}
