<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llamacpp.{{ llamacpp_label }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ llamacpp_server_bin | default('/opt/homebrew/bin/llama-server') }}</string>
        <string>--model</string>
        <string>{{ llamacpp_model_path }}</string>
        <!-- Loopback by default (F2). The bind follows the host's TRANSPORT
             (G30 r4, MDP-4): `lan` -> the role host's LAN IP; `tailnet` ->
             127.0.0.1 only (F-MDP4-2). llama-server has no auth, so it is never
             0.0.0.0 on either transport (F-MDP4-3). NOTE (N3): on a `tailnet`
             host this instance is loopback-only and unreachable from the router
             until it gets a front route of its own — the Caddy front carries
             ollama :11434 only. Flag this when F6.1.2 lands on the M4 Pro. -->
        <string>--host</string>
        <string>{{ inference_bind_ip }}</string>
        <string>--port</string>
        <string>{{ llamacpp_port }}</string>
        <!-- Offload all layers to the Apple Silicon GPU (Metal). -->
        <string>--n-gpu-layers</string>
        <string>-1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ llamacpp_log_dir }}/{{ llamacpp_label }}.log</string>
    <key>StandardErrorPath</key>
    <string>{{ llamacpp_log_dir }}/{{ llamacpp_label }}.err</string>
</dict>
</plist>
