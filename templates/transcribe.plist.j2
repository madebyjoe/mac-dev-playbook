<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.inference.transcribe</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ whisper_server_bin | default('/opt/homebrew/bin/whisper-server') }}</string>
        <string>--model</string>
        <string>{{ whisper_models_dir }}/{{ whisper_model_file }}</string>
        <!-- Loopback by default (F2); an inference role sets lan_ip (G30 = LAN).
             whisper-server has NO auth (N4); a non-loopback bind must be the LAN
             IP, never 0.0.0.0 — firewall-scoped to the Unraid source. -->
        <string>--host</string>
        <string>{{ lan_ip | default('127.0.0.1') }}</string>
        <string>--port</string>
        <string>{{ transcribe_port }}</string>
        <!-- T17 r4 / F16: serve the OpenAI path so the router's openai/ mapping
             reaches this backend without a router rewrite. -->
        <string>--inference-path</string>
        <string>/v1/audio/transcriptions</string>
        <!-- T17 r4 / F17: server-side conversion (ffmpeg) — the alias is
             format-agnostic for all callers (Brief 9 m4a input verified).
             ffmpeg is an explicit dependency of the role, installed and
             asserted by tasks/configure-transcribe.yml — not an assumption. -->
        <string>--convert</string>
        <!-- Decode threads. 8 on the M1 Pro (8 performance cores); overridable
             per host with whisper_threads. -->
        <string>--threads</string>
        <string>{{ whisper_threads | default(8) }}</string>
{%- if whisper_api_key is defined and whisper_api_key %}
        <!-- Only rendered if a key is configured AND the installed build has the
             flag (the run probes `whisper-server --help` and reports which).
             Unset is the norm: this build has no auth, so the LAN bind plus the
             firewall scope to the Unraid source is the only protection, and the
             router sending api_key "none" is honest. -->
        <string>--api-key</string>
        <string>{{ whisper_api_key }}</string>
{%- endif %}
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- T17 r4: launchd's default PATH cannot see /opt/homebrew/bin; without
             this, --convert cannot find ffmpeg and fails silently. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{ whisper_log_dir }}/transcribe.log</string>
    <key>StandardErrorPath</key>
    <string>{{ whisper_log_dir }}/transcribe.err</string>
</dict>
</plist>
