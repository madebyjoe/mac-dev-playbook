{# Periodic warm-keeper agent for the pinned pipeline models (Fault B, mitigation
    3). StartInterval, not KeepAlive: the script is a short one-shot, not a
    daemon — KeepAlive would respawn it in a tight loop. #}
{% set _log_dir = ollama_log_dir | default(ansible_facts.env.HOME + '/Library/Logs/ollama') %}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ollama.warm</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>{{ ollama_warm_script }}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>{{ ollama_warm_interval | default(240) }}</integer>
    <key>StandardOutPath</key>
    <string>{{ _log_dir }}/ollama-warm.log</string>
    <key>StandardErrorPath</key>
    <string>{{ _log_dir }}/ollama-warm.err</string>
</dict>
</plist>
